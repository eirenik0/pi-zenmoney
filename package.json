{
	"name": "pi-zenmoney",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "ZenMoney Pi extension for account discovery and register exports.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"zenmoney"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"package.json",
		"biome.json"
	],
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"fix": "biome check --write ."
	},
	"dependencies": {
		"effect": "^3.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	}
}
